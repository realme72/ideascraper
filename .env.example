# Copy to .env and fill in. .env is gitignored.

# Stage 3 (analysis) only. Stages 1, 2 and 4 need no credentials.
# Free key, no billing required: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Optional. Defaults to gemini-3.7-flash. Override if your free tier allows
# something else, or to trade quality against rate limits.
# GEMINI_MODEL=gemini-3.7-flash

# Optional. Seconds to wait between live model calls, to stay inside a
# free-tier per-minute limit. Defaults to 4.
# GEMINI_CALL_SPACING=4

# Optional. Raises the GitHub API rate limit from 60 to 5000 requests/hour
# when gathering traction signal in stage 2. The pipeline works without it.
GITHUB_TOKEN=
